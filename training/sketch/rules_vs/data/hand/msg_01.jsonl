{"id": "hand-0010", "text": "Call Check Decision", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "rename", "target": "check", "name": "decision"}}], "cat": null}
{"id": "hand-0011", "text": "Write \"begin\" on Start", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "label", "target": "start", "label": "begin"}}], "cat": null}
{"id": "hand-0012", "text": "Hook Start up to Done with a dashed arrow", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "connect", "from": "start", "to": "done", "style": "dashed"}}], "cat": null}
{"id": "hand-0013", "text": "Draw an arrow from Done to Start", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "connect", "from": "done", "to": "start"}}], "cat": null}
