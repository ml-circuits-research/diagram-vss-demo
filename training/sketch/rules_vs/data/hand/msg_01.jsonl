{"id": "hand-0000", "text": "Draw a small red circle named Ball", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "create", "shape": "circle", "size": "small", "color": "red", "name": "ball"}}], "cat": null}
