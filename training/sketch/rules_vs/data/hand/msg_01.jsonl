{"id": "hand-0015", "text": "Line up Start, Process and Check horizontally", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "align", "target": "start,process,check", "axis": "horizontal"}}], "cat": null}
{"id": "hand-0016", "text": "Lay everything out as a grid", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "arrange", "layout": "grid"}}], "cat": null}
{"id": "hand-0017", "text": "Take that back", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "undo"}}], "cat": null}
