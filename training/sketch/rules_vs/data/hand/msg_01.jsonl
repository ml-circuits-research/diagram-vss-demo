{"id": "hand-0026", "text": "Which shape is the largest?", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "question", "args": {"ask": "extreme", "superlative": "biggest"}}], "cat": null}
{"id": "hand-0027", "text": "What's nearest to Start?", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "question", "args": {"ask": "nearest", "anchor": "start", "superlative": "closest"}}], "cat": null}
{"id": "hand-0028", "text": "Is Check to the right of Process?", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "question", "args": {"ask": "check", "target": "check", "position": "rightof", "anchor": "process"}}], "cat": null}
{"id": "hand-0029", "text": "From now on, squares should be gray", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "rule", "args": {"shape": "square", "color": "gray"}}], "cat": null}
{"id": "hand-0030", "text": "Done is red", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "fact", "args": {"target": "done", "color": "red"}}], "cat": null}
{"id": "hand-0031", "text": "Connect the circles in a chain", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "connect", "from": "mention(quantifier=all,shape=circle)", "pairing": "chain"}}], "cat": null}
{"id": "hand-0032", "text": "Link each square to the next one", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "connect", "from": "mention(quantifier=all,shape=square)", "pairing": "next"}}], "cat": null}
{"id": "hand-0033", "text": "Remove the triangles that are not green", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "delete", "target": "mention(notcolor=green,quantifier=all,shape=triangle)"}}], "cat": null}
