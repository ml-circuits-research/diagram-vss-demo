{"id": "broad-0104", "text": "ok now get rid of Process", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "delete", "target": "process"}}], "cat": "casual"}
{"id": "broad-0105", "text": "hmm, make Done a bit smaller", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "resize", "target": "done"}}], "cat": "casual"}
{"id": "broad-0106", "text": "could you please connect Start and Check", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "connect", "from": "start", "to": "check"}}], "cat": "casual"}
{"id": "broad-0107", "text": "so how many stars do I have now?", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "question", "args": {"ask": "count", "shape": "star"}}], "cat": "casual"}
{"id": "broad-0108", "text": "just tell me where Done is", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "question", "args": {"ask": "property", "target": "done", "property": "position"}}], "cat": "casual"}
{"id": "broad-0109", "text": "connect all the squares in a chain", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "connect", "from": "mention(quantifier=all,shape=square)", "pairing": "chain"}}], "cat": "new: pairing"}
{"id": "broad-0110", "text": "connect each circle to the next one", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "connect", "from": "mention(quantifier=all,shape=circle)", "pairing": "next"}}], "cat": "new: pairing"}
{"id": "broad-0111", "text": "delete the stars that are not yellow", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "delete", "target": "mention(notcolor=yellow,quantifier=all,shape=star)"}}], "cat": "new: not colour"}
{"id": "broad-0112", "text": "how many circles are not blue?", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "question", "args": {"ask": "count", "shape": "circle", "notColor": "blue"}}], "cat": "new: not colour"}
{"id": "broad-0113", "text": "distribute the circles evenly vertically", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "distribute", "target": "mention(quantifier=all,shape=circle)", "axis": "vertical"}}], "cat": "new: distribute"}
{"id": "broad-0114", "text": "bring Done to the front", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "toFront", "target": "done"}}], "cat": "new: z-order"}
{"id": "broad-0115", "text": "send Start to the back", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "toBack", "target": "start"}}], "cat": "new: z-order"}
{"id": "broad-0116", "text": "make the last circle green", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "set", "target": "mention(recency=newest,shape=circle)", "color": "green"}}], "cat": "new: recency"}
{"id": "broad-0117", "text": "delete the first star", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "delete", "target": "mention(recency=oldest,shape=star)"}}], "cat": "new: recency"}
{"id": "broad-0118", "text": "Draw a red circle named Hub and connect it to Start", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "create", "shape": "circle", "color": "red", "name": "hub"}}, {"type": "command", "args": {"action": "connect", "from": "$new", "to": "start"}}], "cat": "multi"}
{"id": "broad-0119", "text": "delete Check, then move Done to the center", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "delete", "target": "check"}}, {"type": "command", "args": {"action": "move", "target": "done", "position": "center"}}], "cat": "multi"}
{"id": "broad-0120", "text": "make Start blue and Done yellow", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "set", "target": "start", "color": "blue"}}, {"type": "command", "args": {"action": "set", "target": "done", "color": "yellow"}}], "cat": "multi"}
{"id": "broad-0121", "text": "Add a square named Log below Process and link Process to Log with a dashed arrow", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "create", "shape": "square", "name": "log", "position": "below", "anchor": "process"}}, {"type": "command", "args": {"action": "connect", "from": "process", "to": "$new", "style": "dashed"}}], "cat": "multi"}
{"id": "broad-0122", "text": "draw a green star and a purple hexagon", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "create", "shape": "star", "color": "green"}}, {"type": "command", "args": {"action": "create", "shape": "hexagon", "color": "purple"}}], "cat": "multi"}
{"id": "broad-0123", "text": "Rename Check to Gate. Is Gate connected to Done?", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "rename", "target": "check", "name": "gate"}}, {"type": "question", "args": {"ask": "connected", "target": "gate", "anchor": "done"}}], "cat": "multi"}
{"id": "broad-0124", "text": "connect Start to Process, then Process to Check, then Check to Done", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "connect", "from": "start", "to": "process"}}, {"type": "command", "args": {"action": "connect", "from": "process", "to": "check"}}, {"type": "command", "args": {"action": "connect", "from": "check", "to": "done"}}], "cat": "multi"}
{"id": "broad-0125", "text": "Undo that and make Process orange", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "undo"}}, {"type": "command", "args": {"action": "set", "target": "process", "color": "orange"}}], "cat": "multi"}
{"id": "broad-0126", "text": "Put a tiny white circle at the bottom. How many circles are there now?", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "create", "shape": "circle", "color": "white", "size": "tiny", "position": "bottom"}}, {"type": "question", "args": {"ask": "count", "shape": "circle"}}], "cat": "multi"}
{"id": "broad-0127", "text": "Draw a box called Cache right of Done, label it \"hot\" and connect Done to it", "names": ["Start", "Process", "Check", "Done"], "wires": [{"type": "command", "args": {"action": "create", "shape": "rectangle", "name": "cache", "position": "rightof", "anchor": "done"}}, {"type": "command", "args": {"action": "label", "target": "$new", "label": "hot"}}, {"type": "command", "args": {"action": "connect", "from": "done", "to": "$new"}}], "cat": "multi"}
